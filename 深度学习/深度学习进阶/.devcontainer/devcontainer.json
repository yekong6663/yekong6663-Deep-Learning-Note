{
  "name": "动手学深度学习（PyTorch）",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--shm-size=8g"
  ],
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/opt/conda/envs/d2l/bin:${containerEnv:PATH}"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/deep-learning-book,type=bind",
  "workspaceFolder": "/workspaces/deep-learning-book",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "12gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "anthropic.claude-code",
        "OpenAI.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/d2l/bin/python",
        "jupyter.jupyterServerType": "local",
        "terminal.integrated.defaultProfile.linux": "bash",
        "notebook.output.textLineLimit": 2000,
        "files.watcherExclude": {
          "**/.d2l/**": true
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
