#!/usr/bin/env bash
set -euo pipefail

# 与教材安装章节一致：仅首次创建时取得中文 PyTorch Notebook。
notebook_dir="${PWD}/d2l-zh"
if [[ -d "${notebook_dir}/pytorch" ]]; then
  echo "D2L PyTorch notebooks already exist: ${notebook_dir}/pytorch"
  exit 0
fi

archive_path="$(mktemp)"
trap 'rm -f "${archive_path}"' EXIT

echo "Downloading D2L Chinese notebooks..."
curl --fail --location --retry 3 \
  https://zh-v2.d2l.ai/d2l-zh-2.0.0.zip \
  --output "${archive_path}"
mkdir -p "${notebook_dir}"
unzip -q "${archive_path}" -d "${notebook_dir}"
echo "D2L PyTorch notebooks are available in: ${notebook_dir}/pytorch"
